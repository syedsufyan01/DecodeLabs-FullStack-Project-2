# Copy this file to .env and set your own values.
PORT=5000
NODE_ENV=development

# API keys used to demonstrate authentication (who are you?) and authorization (what can you do?).
# Generate a random key with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_KEY=replace-with-a-long-random-admin-key
USER_API_KEY=replace-with-a-long-random-user-key

# Maximum JSON body size accepted by the server
JSON_LIMIT=10kb

# Rate limiting: max requests per IP per window (window in milliseconds)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
